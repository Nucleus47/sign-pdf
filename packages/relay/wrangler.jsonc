// The production Worker: it serves the built web app in ../web/dist as static
// assets and answers the relay API under /relay/ (docs/relay.md). The _headers
// file in the assets directory sets the security headers on every asset
// response. Only /relay and /relay/* run the Worker script first; every other
// path is served as an asset, and an unknown path gets index.html.
//
// The vars below are the production values. `pnpm dev` overrides the mail
// transport with --var flags, so a local run never sends mail.
// RELAY_MODE is the feature flag for the email relay: "off" (the production
// value for now) answers 404 on every /relay path, so the site shows only the
// on-device flow. Set it to "on" to offer email hand-off (docs/relay.md).
// Secrets, never in this file: RELAY_SESSION_SECRET, and TURNSTILE_SECRET only
// when TURNSTILE_MODE is "on". Turnstile is off until there is real traffic;
// the rate limits and the daily login caps hold meanwhile (docs/relay.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sign-pdf",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "routes": [{ "pattern": "sign.silv.app", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/relay", "/relay/*"]
  },
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "sign-pdf-relay" }],
  "send_email": [{ "name": "EMAIL" }],
  // Per-location counters; the period must be 10 or 60 seconds. Keys carry an
  // "ip:" or "email:" prefix, so one binding can count both.
  "ratelimits": [
    { "name": "RL_LOGIN_IP", "namespace_id": "6801", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_LOGIN_EMAIL", "namespace_id": "6802", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_VERIFY", "namespace_id": "6803", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_UPLOAD", "namespace_id": "6804", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "6805", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "RELAY_MODE": "off",
    "TURNSTILE_MODE": "off",
    "TURNSTILE_SITE_KEY": "",
    "MAIL_TRANSPORT": "cloudflare",
    "PUBLIC_ORIGIN": "https://sign.silv.app",
    "MAIL_FROM": "sign@e.silv.app"
  },
  "observability": {
    "enabled": true
  }
}

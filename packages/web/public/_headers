/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none';

# Cache immutable assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache worker files
/*.worker.*.js
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Prevent edge caching of HTML and unhashed static files
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/*.md
  Cache-Control: no-cache, no-store, must-revalidate

/*.txt
  Cache-Control: no-cache, no-store, must-revalidate

/*.json
  Cache-Control: no-cache, no-store, must-revalidate

/*.pdf
  Cache-Control: no-cache, no-store, must-revalidate

/*.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
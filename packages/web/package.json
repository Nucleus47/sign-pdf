{
  "name": "@sign-pdf/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Static web app: PDF viewer, prepare view, sign view and signature capture.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build && node scripts/check-bundle.mjs",
    "lint": "eslint src",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sign-pdf/core": "workspace:*",
    "@sign-pdf/spec": "workspace:*",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "browserslist": "^4.29.3",
    "es-check": "^9.8.1",
    "eslint": "^10.12.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "browserslist": [
    "ios_saf >= 16.4",
    "safari >= 16.4",
    "chrome >= 110"
  ]
}
